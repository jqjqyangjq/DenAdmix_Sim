
#included individual bed contains records of Denisovna segments identified:
#1. by admixfrog, physical length > 19999 and map length >0.0249cM
#2. by hmmix if any, physical length >19999 and map length >0.0249, further requiring: 
#2.1 number of derived alleles matching Denisovan larger > number of derived alleles matching Neanderthals
#2.2 number of derived alleles matching Denisovan >=4
#2.3 match rate is highest for Denisovan(any) than any Neanderthals
#In All analysis, I used only segments longer than 40000bp and 0.05cM. 

#format for candidate segments: chr, pos_start, pos_end, pos_length, map_start, map_end, map_length, method(frog or hmm)
#for candidate tagged as hmm, the following 5 columns:
#match rate to Denisova3
#match rate to Denisova25
#number of derived allels matching Neanderthals ONLY
#number of derived alleles matching Denisovans ONLY
#number of derived alleles matching BOTH Neanderthals and Denisovans





#use .ipynb to genreate all candidate Denisovan segments(HMM) in present-day East Asians. All_EA_filtered.non_verlap.bed


bedtools intersect -a All_EA_filtered.non_verlap.bed -b Tianyuan.bed  -wa -wb | awk -v OFS='\t' '{print $0, Tianyuan}'> TY_overlap.bed
bedtools intersect -a All_EA_filtered.non_verlap.bed -b Salkhit.bed  -wa -wb | awk -v OFS='\t' '{print $0, "Salkhit"}'>> TY_overlap.bed
bedtools intersect -a All_EA_filtered.non_verlap.bed -b <(awk  '($8=="frog")' Yana1.bed)  -wa -wb  | awk -v OFS='\t' '{print $0, "Yana1"}'  >>  TY_overlap.bed
bedtools intersect -a All_EA_filtered.non_verlap.bed -b <(awk  '($8=="frog")' Yana2.bed)  -wa -wb  | awk -v OFS='\t' '{print $0, "Yana2"}'  >>  TY_overlap.bed
bedtools intersect -a All_EA_filtered.non_verlap.bed -b <(awk -v OFS='\t'  '($8=="hmm"){print $1,$2,$3,$4,$5,$6,$7,$8,"Yana1",$9,$10,$11,$12,$13}' Yana1.bed)  -wa -wb >> TY_overlap.bed
bedtools intersect -a All_EA_filtered.non_verlap.bed -b <(awk -v OFS='\t'  '($8=="hmm"){print $1,$2,$3,$4,$5,$6,$7,$8,"Yana2",$9,$10,$11,$12,$13}' Yana2.bed)  -wa -wb >> TY_overlap.bed
 awk '($23>=40000&&$26>=0.0499){print $1,$2,$3,$18}' TY_overlap.bed | sort -k1n,1 -k2n,2 | uniq   > TY_overlap.uniq.bed

for i in JpKa6904 JpKo13 JpKo2 JpOd181 JpOd274 JpOd282 JpOd6 JpFu1 F23 F5 JpHi01 IK002;do bedtools intersect -a All_EA_filtered.non_verlap.bed -b  <(awk -v OFS='\t' '{print $1,$2,$3,$4,$5,$6,$7}' ${i}.bed)  -wa -wb | awk -v OFS='\t' -v ind=${i} '{print $0,ind }' >> JM_overlap.bed;done

awk '($23>=40000&&$26>=0.0499){print $1,$2,$3,$4,$5,$6,$7,$11,$12,$13,$18,$19,$20,$21,$22,$23,$24,$25,$26,$28}' JM_overlap.bed | column -t  | sort -k1,1n -k2,2n | awk -v OFS='\t' '{print $1,$2,$3,$11}' | uniq > JM_overlap.uniq.bed

